{
  "_comment": "Live repository state shaped like the REST API responses, with the drift .github/repo.json exists to remove: merge commits allowed, no SHA pinning, CodeQL default setup off.",
  "repo": {
    "allow_squash_merge": true,
    "allow_merge_commit": true,
    "allow_rebase_merge": false,
    "allow_auto_merge": false,
    "delete_branch_on_merge": true,
    "squash_merge_commit_title": "COMMIT_OR_PR_TITLE",
    "squash_merge_commit_message": "COMMIT_MESSAGES",
    "has_wiki": false,
    "description": "Personal site and writeups. Strict nonce CSP, edge-tested, and released with signed provenance.",
    "homepage": "https://jseverino.com",
    "topics": ["astro", "typescript"],
    "security_and_analysis": {
      "secret_scanning": { "status": "enabled" },
      "secret_scanning_push_protection": { "status": "disabled" },
      "dependabot_security_updates": { "status": "disabled" }
    }
  },
  "vulnerabilityAlerts": true,
  "privateReporting": false,
  "codeScanning": {
    "state": "not-configured",
    "languages": [],
    "query_suite": "default",
    "threat_model": "remote",
    "runner_type": null,
    "runner_label": null,
    "updated_at": null,
    "schedule": null
  },
  "permissions": { "enabled": true, "allowed_actions": "all", "sha_pinning_required": false },
  "workflow": { "default_workflow_permissions": "read", "can_approve_pull_request_reviews": false },
  "variables": [{ "name": "UNRELATED", "value": "kept" }],
  "rulesets": [
    {
      "id": 101,
      "name": "main",
      "target": "branch",
      "enforcement": "active",
      "source_type": "Repository",
      "bypass_actors": [],
      "conditions": { "ref_name": { "exclude": [], "include": ["~DEFAULT_BRANCH"] } },
      "rules": [
        { "type": "required_signatures" },
        { "type": "deletion" },
        { "type": "non_fast_forward" },
        {
          "type": "required_status_checks",
          "parameters": {
            "strict_required_status_checks_policy": false,
            "do_not_enforce_on_create": false,
            "required_status_checks": [
              { "context": "visual" },
              { "context": "build" },
              { "context": "e2e" },
              { "context": "edge" },
              { "context": "dependency-review" },
              { "context": "deploy", "integration_id": 15368 }
            ]
          }
        },
        {
          "type": "code_scanning",
          "parameters": {
            "code_scanning_tools": [{ "security_alerts_threshold": "high_or_higher", "alerts_threshold": "errors", "tool": "CodeQL" }]
          }
        },
        {
          "type": "pull_request",
          "parameters": {
            "required_reviewers": [],
            "required_review_thread_resolution": true,
            "required_approving_review_count": 0,
            "require_last_push_approval": false,
            "require_extra_approval_for_unattributed_changes": true,
            "require_code_owner_review": false,
            "dismiss_stale_reviews_on_push": false,
            "allowed_merge_methods": ["squash"]
          }
        }
      ]
    }
  ]
}
