{
  "_comment": "Live repository state shaped like the REST API responses, with the drift github/repo.json exists to remove: merge commits allowed, no SHA pinning, a ruleset missing one required check.",
  "repo": {
    "allow_squash_merge": true,
    "allow_merge_commit": true,
    "allow_rebase_merge": false,
    "allow_auto_merge": true,
    "delete_branch_on_merge": true,
    "squash_merge_commit_title": "COMMIT_OR_PR_TITLE",
    "squash_merge_commit_message": "COMMIT_MESSAGES",
    "has_wiki": false,
    "security_and_analysis": {
      "secret_scanning": { "status": "enabled" },
      "secret_scanning_push_protection": { "status": "disabled" },
      "dependabot_security_updates": { "status": "enabled" }
    }
  },
  "vulnerabilityAlerts": true,
  "privateReporting": false,
  "permissions": { "enabled": true, "allowed_actions": "all", "sha_pinning_required": false },
  "workflow": { "default_workflow_permissions": "read", "can_approve_pull_request_reviews": false },
  "rulesets": [
    {
      "id": 101,
      "name": "main",
      "target": "branch",
      "enforcement": "active",
      "source_type": "Repository",
      "bypass_actors": [{ "actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "always" }],
      "conditions": { "ref_name": { "exclude": [], "include": ["~DEFAULT_BRANCH"] } },
      "rules": [
        { "type": "required_signatures" },
        { "type": "deletion" },
        { "type": "non_fast_forward" },
        {
          "type": "required_status_checks",
          "parameters": {
            "strict_required_status_checks_policy": false,
            "do_not_enforce_on_create": false,
            "required_status_checks": [
              { "context": "visual" },
              { "context": "build" },
              { "context": "e2e" },
              { "context": "edge" },
              { "context": "dependency-review" },
              { "context": "Cloudflare Pages", "integration_id": 85455 },
              { "context": "analyze typescript", "integration_id": 15368 }
            ]
          }
        },
        {
          "type": "pull_request",
          "parameters": {
            "required_reviewers": [],
            "required_review_thread_resolution": true,
            "required_approving_review_count": 0,
            "require_last_push_approval": false,
            "require_extra_approval_for_unattributed_changes": true,
            "require_code_owner_review": false,
            "dismiss_stale_reviews_on_push": false,
            "allowed_merge_methods": ["squash"]
          }
        }
      ]
    }
  ]
}
