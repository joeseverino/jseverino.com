{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "target": "ES2025",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2025", "DOM"],
    "types": ["node"],
    "allowJs": false,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "erasableSyntaxOnly": true,
    "paths": {
      "@components/*": ["./src/components/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@lib/*": ["./src/lib/*"],
      "@styles/*": ["./src/styles/*"]
    }
  },
  // The Worker's entry points and its runtime types compile in tsconfig.worker.json.
  "exclude": [
    "dist",
    "node_modules",
    "playwright-report",
    "test-results",
    "public",
    "worker-configuration.d.ts",
    "src/pages/api",
    "src/integrations/sitedrift-route.ts"
  ]
}
