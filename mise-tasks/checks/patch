#!/bin/sh
#MISE description="No whitespace error in what the branch changes, committed or not, and no conflict marker in any tracked file"
set -eu

# What the branch changes is measured from its base. In Actions that is the
# checked-out commit's first parent: a pull request's merge commit sits on its
# base branch, and a push to main is one squash commit on the previous tip. The
# checkout is one commit deep, so the parent is fetched first. Elsewhere it is
# where the branch left origin's default branch.
if [ "${GITHUB_ACTIONS:-}" = true ]; then
  if [ "$(git rev-parse --is-shallow-repository)" = true ]; then
    git fetch --quiet --no-tags --depth=2 origin "$(git rev-parse HEAD)"
  fi
  base=$(git rev-parse --verify HEAD^1)
else
  default=$(git rev-parse --abbrev-ref origin/HEAD) || {
    echo 'fix: origin/HEAD is not set; run: git remote set-head origin --auto' >&2
    exit 2
  }
  base=$(git merge-base HEAD "$default")
fi

status=0

# Against the working tree, so staged and unstaged edits count with the commits.
git diff --check "$base" || {
  echo "fix: remove the trailing whitespace or blank lines at end of file named above (changes since $(git rev-parse --short "$base"))" >&2
  status=1
}

# git grep exits 1 when nothing matches and above 1 when it cannot run.
found=0
git grep -nE '^(<{7}|>{7})( |$)' || found=$?
case "$found" in
  0)
    echo 'fix: resolve the merge conflict markers named above' >&2
    status=1
    ;;
  1) ;;
  *) status="$found" ;;
esac

exit "$status"
