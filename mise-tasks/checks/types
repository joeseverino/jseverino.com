#!/bin/sh
#MISE description="Every TypeScript file compiles under one strict program, the Worker's routes again under the Workers runtime types, and those types match wrangler.jsonc (fix: `wrangler types src/generated/worker-configuration.d.ts`)"
set -eu

# astro sync writes the generated types under .astro/ that tsc reads.
astro sync --silent
tsc -p .
wrangler types src/generated/worker-configuration.d.ts --check
tsc -p src/tsconfig.worker.json
