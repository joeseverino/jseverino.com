#!/bin/sh
#MISE description="Install Playwright's browsers and their system packages (BROWSERS, space-separated) while the site builds with the test site key (PREBUILD=true), for a browser suite run with PREBUILT"
#MISE timeout="20m"
set -eu

# The install runs in the background so the build does not wait on it. Its
# output streams, so a stalled install shows where it stopped.
pid=''
if [ -n "${BROWSERS:-}" ]; then
  # shellcheck disable=SC2086 # the browser list is space-separated
  playwright install --with-deps $BROWSERS &
  pid=$!
fi
if [ "${PREBUILD:-}" = true ]; then
  node tests/browser-test-env.ts build
fi
if [ -n "$pid" ]; then
  wait "$pid"
fi
