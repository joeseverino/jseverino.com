# Static-asset redirects: https://developers.cloudflare.com/workers/static-assets/redirects/
# Format:  <source>  <destination>  [<status>]
#
# To make a path return 404, leave it unmatched: wrangler.jsonc's
# `not_found_handling: "404-page"` serves the root 404.html with status 404.

# The old /category/portfolio/ archive is /portfolio/.
/category/portfolio/   /portfolio/                       301

# The DNS filtering writeup's longer slug, which links to the page and its assets still carry.
/portfolio/building-local-dns-filtering-with-adguard-home-and-docker-engine/    /portfolio/building-local-dns-filtering/    301
/assets/writeups/building-local-dns-filtering-with-adguard-home-and-docker-engine/*    /assets/writeups/building-local-dns-filtering/:splat    301

# The resume's snake_case file name, which older links and applications carry.
/assets/docs/Joseph_Severino_Resume.pdf  /assets/docs/joseph-severino-resume.pdf  301

# The default social card is a JPEG; shares and caches that hold the PNG URL still resolve.
/assets/og/og-default.png  /assets/og/og-default.jpg  301
