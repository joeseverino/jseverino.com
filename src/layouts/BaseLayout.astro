---
import SeoHead from '@components/SeoHead.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import SocialIconsDefs from '@components/SocialIconsDefs.astro';
import { SURFACE } from '@lib/brand.mjs';
import '@styles/base.css';

type Props = {
  seo?: Parameters<typeof SeoHead>[0];
  bodyClass?: string;
  /** Extra third-party origins to preconnect to, beyond the site-wide defaults. */
  preconnect?: string[];
};

const { seo = {}, bodyClass, preconnect = [] } = Astro.props;

// `static.cloudflareinsights.com` serves the Cloudflare Web Analytics beacon,
// auto-injected into every HTML response by the Cloudflare proxy. Warming the
// DNS + TLS connection here removes ~100-300ms of cold-start latency for it.
const preconnectOrigins = ['https://static.cloudflareinsights.com', ...preconnect];
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Duplicates the `color-scheme` in base.css on purpose. The stylesheet only
        applies once it has loaded, and until then the document scheme is
        `normal`, so the browser paints a white canvas, light scrollbars, and
        light form controls even on a dark-mode OS. This is parsed first and
        gets the paint right from the very first frame. */}
    <meta name="color-scheme" content="light dark" />
    {/* Browser-chrome tint. Media-scoped so it works with JS off, but the scopes
        follow the OS, not an explicit override — so the script below re-points
        them. They sit ABOVE that script on purpose: browsers sample theme-color
        while parsing the head, so a deferred fixup lands too late to be read. */}
    <meta name="theme-color" data-scheme="light" media="(prefers-color-scheme: light)" content={SURFACE.light} />
    <meta name="theme-color" data-scheme="dark" media="(prefers-color-scheme: dark)" content={SURFACE.dark} />
    <script is:inline>
      (() => {
        let mode = 'auto';
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') mode = stored;
        } catch {}
        const root = document.documentElement;
        root.dataset.themeMode = mode;
        if (mode === 'auto') return;
        root.style.colorScheme = mode;
        for (const meta of document.querySelectorAll('meta[name="theme-color"]')) {
          meta.media = meta.dataset.scheme === mode ? 'all' : 'not all';
        }
      })();
    </script>
    {preconnectOrigins.map((origin) => <link rel="preconnect" href={origin} crossorigin />)}
    <link
      rel="preload"
      href="/assets/fonts/inter/inter-variable-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <SeoHead {...seo} />
    <link rel="alternate" type="application/rss+xml" title="Joe Severino — Portfolio" href="/feed.xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/assets/icons/favicon.svg" />
    <link rel="icon" href="/assets/icons/favicon-32.png" sizes="32x32" />
    <link rel="icon" href="/assets/icons/favicon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png" />
  </head>
  <body class={bodyClass || undefined}>
    <a class="skip-link" href="#main">Skip to main content</a>
    <SocialIconsDefs />
    <div class="page-shell">
      <Header />
      <slot />
      <Footer />
    </div>
  </body>
</html>
