---
import type { ComponentProps } from 'astro/types';
import SeoHead from '@components/SeoHead.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import SocialIconsDefs from '@components/SocialIconsDefs.astro';
import { SURFACE } from '@lib/brand.ts';
import { site } from '@lib/site.ts';
import { CSP_INLINE_MARKER, INSIGHTS_SCRIPT_ORIGIN } from '@lib/csp.ts';
import '@styles/base.css';

type Props = {
  seo?: ComponentProps<typeof SeoHead>;
  /** Extra third-party origins to preconnect to, beyond the site-wide defaults. */
  preconnect?: string[];
};

const { seo = {}, preconnect = [] } = Astro.props;

// The zone injects the Web Analytics beacon; preconnect warms DNS and TLS for its origin.
const preconnectOrigins = [INSIGHTS_SCRIPT_ORIGIN, ...preconnect];
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" data-scheme="light" media="(prefers-color-scheme: light)" content={SURFACE.light} />
    <meta name="theme-color" data-scheme="dark" media="(prefers-color-scheme: dark)" content={SURFACE.dark} />
    <script is:inline nonce={CSP_INLINE_MARKER}>
      (() => {
        let mode = 'auto';
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') mode = stored;
        } catch {}
        const root = document.documentElement;
        root.dataset.themeMode = mode;
        if (mode === 'auto') return;
        root.style.colorScheme = mode;
        for (const meta of document.querySelectorAll('meta[name="theme-color"]')) {
          meta.media = meta.dataset.scheme === mode ? 'all' : 'not all';
        }
      })();
    </script>
    {preconnectOrigins.map((origin) => <link rel="preconnect" href={origin} crossorigin />)}
    <link
      rel="preload"
      href="/assets/fonts/inter/inter-variable-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <SeoHead {...seo} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}: Portfolio`} href="/feed.xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/assets/icons/favicon.svg" />
    <link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <SocialIconsDefs />
    <div class="page-shell">
      <Header />
      <slot />
      <Footer />
    </div>
  </body>
</html>
