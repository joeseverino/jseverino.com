---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import ContentBody from '@components/content/ContentBody.astro';
import type { PageContent } from '@lib/content.ts';

type Props = {
  page: PageContent;
  parents?: { name: string; url: string }[];
  pageType?: 'profile';
  preconnect?: string[];
  mainClass?: string;
  lede?: boolean;
  prose?: boolean;
};

const { page, parents = [], pageType, preconnect, mainClass, lede = true, prose = true } = Astro.props;
const breadcrumbs = [{ name: 'Home', url: '/' }, ...parents, { name: page.title, url: page.path }];
---

<BaseLayout
  seo={{ title: page.title, description: page.description, path: page.path, breadcrumbs, ...(pageType ? { pageType } : {}) }}
  {...(preconnect ? { preconnect } : {})}
>
  <main id="main" class:list={['content-page', mainClass]}>
    <div class="content-flow">
      <PageHero title={page.title} {...(lede ? { description: page.intro ?? page.description } : {})} />
      {
        prose ? (
          <div class="prose">
            <ContentBody entry={page.entry} />
            <slot />
          </div>
        ) : (
          <ContentBody entry={page.entry} />
        )
      }
    </div>
  </main>
</BaseLayout>
