---
import { site } from '@lib/site.ts';
import NavLinks from '@components/NavLinks.astro';
import SocialLinks from '@components/SocialLinks.astro';
import wordmark from '../../public/assets/brand/wordmark-caps.svg?raw';

// The template's <svg> owns sizing and accessibility; inline only the geometry.
const wordmarkInner = wordmark.replace(/^<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
const wordmarkViewBox = /^<svg[^>]*\sviewBox="([^"]+)"/.exec(wordmark)?.[1];
if (!wordmarkViewBox) throw new Error('wordmark-caps.svg needs a viewBox on its root <svg>.');

const current = Astro.url.pathname;
const normalize = (p: string) => p.replace(/\/$/, '') || '/';
const { name, navItems, socialLinks, focusLabel } = site;
const navigation = navItems.map((item) => ({
  ...item,
  current: normalize(current) === normalize(item.href),
}));
---

<div id="scroll-sentinel" class="scroll-sentinel"></div>
<header class="site-header" data-sticky-header>
  <div class="wide site-nav">
    <a class="brand" href="/" rel="home" draggable="false" aria-current={current === '/' ? 'page' : undefined} aria-label={name}>
      <svg class="brand-mark" viewBox={wordmarkViewBox} aria-hidden="true" focusable="false" set:html={wordmarkInner} />
    </a>

    <nav class="primary-nav" aria-label="Primary navigation">
      <NavLinks items={navigation} listClass="nav-list" linkClass="nav-link" />
    </nav>

    <button class="nav-toggle" type="button" popovertarget="mobile-nav" aria-label="Menu" data-nav-toggle>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
    </button>
  </div>

  <nav class="mobile-nav" id="mobile-nav" popover="auto" aria-label="Mobile navigation" data-mobile-nav>
    <NavLinks items={navigation} listClass="mobile-nav-list" linkClass="mobile-nav-link" />
    <div class="mobile-nav-footer">
      <p class="page-kicker">{focusLabel}</p>
      <SocialLinks links={socialLinks} class="mobile-nav-social" />
    </div>
  </nav>
</header>

<script>
  if (!CSS.supports('animation-timeline', 'scroll()')) {
    const header = document.querySelector('[data-sticky-header]');
    const sentinel = document.querySelector('#scroll-sentinel');
    if (header && sentinel) {
      const observer = new IntersectionObserver(([entry]) => {
        if (entry) header.classList.toggle('scrolled', !entry.isIntersecting);
      }, { threshold: 0 });
      observer.observe(sentinel);
    }
  }

  const mobileNav = document.querySelector<HTMLElement>('[data-mobile-nav]');

  if (mobileNav) {
    document.body.classList.add('nav-js-ready');

    mobileNav.addEventListener('click', (event) => {
      if (event.target instanceof Element && (event.target === mobileNav || event.target.closest('a'))) {
        mobileNav.hidePopover();
      }
    });
  }
</script>
