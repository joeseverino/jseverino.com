---
// Its behavior is Header.client.ts, which BaseLayout loads on every page.
import { site } from '@lib/site.ts';
import NavLinks from '@components/NavLinks.astro';
import SocialLinks from '@components/SocialLinks.astro';
import wordmark from '../../public/assets/brand/wordmark-caps.svg?raw';

// The template's <svg> owns sizing and accessibility; inline only the geometry.
const wordmarkInner = wordmark.replace(/^<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
const wordmarkViewBox = /^<svg[^>]*\sviewBox="([^"]+)"/.exec(wordmark)?.[1];
if (!wordmarkViewBox) throw new Error('wordmark-caps.svg needs a viewBox on its root <svg>.');

const current = Astro.url.pathname;
const normalize = (p: string) => p.replace(/\/$/, '') || '/';
const { name, navItems, focusLabel } = site;
const navigation = navItems.map((item) => ({
  ...item,
  current: normalize(current) === normalize(item.href),
}));
---

<div class="scroll-sentinel"></div>
<header class="site-header" data-sticky-header>
  <div class="wide site-nav">
    <a class="brand" href="/" rel="home" draggable="false" aria-current={current === '/' ? 'page' : undefined} aria-label={name}>
      <svg class="brand-mark" viewBox={wordmarkViewBox} aria-hidden="true" set:html={wordmarkInner} />
    </a>

    <nav class="primary-nav" aria-label="Primary navigation">
      <NavLinks items={navigation} listClass="nav-list" linkClass="nav-link" />
    </nav>

    <button class="nav-toggle" type="button" popovertarget="mobile-nav" aria-label="Menu" data-nav-toggle>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
    </button>
  </div>

  <nav class="mobile-nav" id="mobile-nav" popover aria-label="Mobile navigation" data-mobile-nav>
    <NavLinks items={navigation} listClass="mobile-nav-list" linkClass="mobile-nav-link" />
    <div class="mobile-nav-footer">
      <p class="page-kicker">{focusLabel}</p>
      <SocialLinks />
    </div>
  </nav>
</header>
