---
import { formatDate, type Writeup } from '@lib/content.ts';
import { writeupPath } from '@lib/site-config.ts';
import Picture from '@components/Picture.astro';

type Props = {
  writeup: Writeup;
  eager?: boolean;
  headingLevel?: 2 | 3;
};

const { writeup, eager = false, headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as const;
---

<li class="project-card">
  <div class="card-surface">
    <Heading class="project-card-title">
      <a href={writeupPath(writeup.slug)}>{writeup.title}</a>
    </Heading>
    <figure class="project-card-media">
      <a href={writeupPath(writeup.slug)} tabindex="-1" aria-hidden="true">
        <Picture
          src={writeup.heroImage}
          alt={writeup.heroAlt}
          sizes="(max-width: 700px) 100vw, 360px"
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : undefined}
        />
      </a>
    </figure>
    <p class="project-card-summary">{writeup.description}</p>
    <div class="project-card-date">
      <time datetime={writeup.date}>{formatDate(writeup.date)}</time>
    </div>
  </div>
</li>
