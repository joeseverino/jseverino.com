---
// Progressive enhancement: without JS the images stay plain.
---

<dialog class="lightbox" aria-label="Image viewer" tabindex="-1">
  <button class="lightbox-close" type="button" aria-label="Close">×</button>
  <figure class="lightbox-figure">
    <img class="lightbox-img" alt="" />
    <figcaption class="lightbox-caption" hidden></figcaption>
  </figure>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox');
  const view = dialog?.querySelector<HTMLImageElement>('.lightbox-img');
  const caption = dialog?.querySelector<HTMLElement>('.lightbox-caption');

  if (dialog && view && caption && typeof dialog.showModal === 'function') {
    let lastTrigger: HTMLElement | null = null;
    let restoreFocusOnClose = false;

    for (const img of document.querySelectorAll<HTMLImageElement>('.prose img')) {
      if (img.closest('[data-no-zoom]')) continue;
      const trigger = document.createElement('button');
      const media = img.closest('picture') ?? img;
      trigger.className = 'image-zoom';
      trigger.type = 'button';
      trigger.setAttribute('aria-haspopup', 'dialog');
      trigger.setAttribute('aria-label', img.alt ? `Open image: ${img.alt}` : 'Open image');
      media.before(trigger);
      trigger.append(media);
    }

    const open = (trigger: HTMLElement, restoreFocus: boolean) => {
      const img = trigger.querySelector<HTMLImageElement>('img');
      if (!img) return;
      lastTrigger = trigger;
      restoreFocusOnClose = restoreFocus;
      // currentSrc is already cached, so the modal opens without a refetch.
      view.src = img.currentSrc || img.src;
      view.alt = img.alt;

      const figcaption = img.closest('figure')?.querySelector('figcaption');
      if (figcaption) {
        caption.replaceChildren(...Array.from(figcaption.childNodes, (node) => node.cloneNode(true)));
        caption.hidden = false;
      } else if (img.alt) {
        caption.replaceChildren(img.alt);
        caption.hidden = false;
      } else {
        caption.replaceChildren();
        caption.hidden = true;
      }

      dialog.showModal();
      dialog.focus({ preventScroll: true });
    };

    document.addEventListener('click', (event) => {
      const { target } = event;
      if (!(target instanceof Element)) return;
      const trigger = target.closest<HTMLElement>('.prose .image-zoom');
      if (trigger) {
        open(trigger, false);
        return;
      }
      // Any click dismisses except on the caption, so its text stays selectable.
      if (dialog.open && target.closest('dialog.lightbox') && !target.closest('.lightbox-caption')) {
        dialog.close();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      const trigger = event.target instanceof Element ? event.target.closest<HTMLElement>('.prose .image-zoom') : null;
      if (!trigger) return;
      event.preventDefault();
      open(trigger, true);
    });

    dialog.addEventListener('close', () => {
      const trigger = lastTrigger;
      if (restoreFocusOnClose) {
        trigger?.focus({ preventScroll: true });
      } else if (trigger && document.activeElement === trigger) {
        trigger.blur();
      }
      restoreFocusOnClose = false;
    });
  }
</script>
