---
type Props = {
  title: string;
  description?: string;
  class?: string;
};

const { title, description, class: className } = Astro.props;
const classes = ['page-hero', className].filter(Boolean).join(' ');
---

<header class={classes}>
  <h1>{title}</h1>
  {description && <p class="page-intro">{description}</p>}
  <slot />
</header>
