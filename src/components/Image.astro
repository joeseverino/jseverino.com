---
// Never read the image's metadata here: it marks the original as referenced,
// and Astro would ship the unprocessed file with its EXIF.
// A URL string (the default social card) renders as a plain <img>, given the
// attributes Astro's `priority` sets on a processed one.
import type { ImageMetadata } from 'astro';
import { Image as AstroImage } from 'astro:assets';
import { IMAGE_WIDTHS } from '@lib/images.ts';

type Props = {
  src: ImageMetadata | string;
  alt?: string | undefined;
  class?: string | undefined;
  sizes?: string | undefined;
  // The page's first image above the fold: fetched first, never lazily.
  priority?: boolean | undefined;
  width?: number | undefined;
  noZoom?: boolean | undefined;
};

const { src, alt = '', class: className, priority = false, width, noZoom = false } = Astro.props;
const sizes = Astro.props.sizes ?? (width ? `(min-width: 600px) ${width}px, 100vw` : '(max-width: 720px) 100vw, 672px');
const zoom = noZoom ? { 'data-no-zoom': '' } : {};
---

{
  typeof src === 'string' ? (
    <img
      src={src}
      alt={alt}
      class={className}
      loading={priority ? 'eager' : 'lazy'}
      decoding={priority ? 'sync' : 'async'}
      fetchpriority={priority ? 'high' : undefined}
      {...zoom}
    />
  ) : (
    <AstroImage
      src={src}
      alt={alt}
      class={className}
      format="avif"
      widths={IMAGE_WIDTHS}
      sizes={sizes}
      {...(width ? { width } : {})}
      priority={priority}
      {...zoom}
    />
  )
}
