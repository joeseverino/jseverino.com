---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { site } from '@lib/site.ts';

type Breadcrumb = { name: string; url: string };
type ListItem = Breadcrumb;

type Props = {
  title?: string;
  description?: string;
  path?: string;
  image?: ImageMetadata | string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string | undefined;
  tags?: string[];
  breadcrumbs?: Breadcrumb[];
  pageType?: 'profile' | 'collection' | 'itemList';
  itemListItems?: ListItem[];
};

const {
  title = site.defaultTitle,
  description = site.defaultDescription,
  path = Astro.url.pathname,
  image = site.defaultOgImage,
  type = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  tags = [],
  breadcrumbs = [],
  pageType,
  itemListItems = [],
} = Astro.props;

const canonical = new URL(path, site.url).href;
const personId = `${site.url}/#person`;
const websiteId = `${site.url}/#website`;
// A content image becomes a 1200px JPEG card, the format every platform
// reads; getImage reports its size without exposing the original.
const card = typeof image === 'string'
  ? { src: image, ...(image === site.defaultOgImage ? { width: site.defaultOgImageWidth, height: site.defaultOgImageHeight } : {}) }
  : await (async () => {
      const { src, attributes } = await getImage({ src: image, width: 1200, format: 'jpg' });
      return { src, width: Number(attributes.width), height: Number(attributes.height) };
    })();
const ogImage = new URL(card.src, site.url).href;
const personImage = new URL('/assets/brand/joe-severino.jpg', site.url).href;
const ogDimensions = card.width && card.height ? { width: card.width, height: card.height } : undefined;
const fullTitle = title === site.defaultTitle ? title : `${title} | ${site.name}`;

const imageObject: Record<string, unknown> = {
  '@type': 'ImageObject',
  url: ogImage,
  ...(ogDimensions ? { width: ogDimensions.width, height: ogDimensions.height } : {}),
};

const person = {
  '@type': 'Person',
  '@id': personId,
  name: site.name,
  url: site.url,
  image: personImage,
  jobTitle: site.jobTitle,
  worksFor: { '@type': 'Organization', name: site.employer },
  description: site.summary,
  knowsAbout: site.skills,
  sameAs: site.socialLinks.map((link) => link.href),
};

const breadcrumbList =
  breadcrumbs.length > 0
    ? {
        '@type': 'BreadcrumbList',
        '@id': `${canonical}#breadcrumb`,
        itemListElement: breadcrumbs.map((bc, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: bc.name,
          item: new URL(bc.url, site.url).href,
        })),
      }
    : undefined;

type JsonLdNode = Record<string, unknown>;
type JsonLd = {
  '@context': 'https://schema.org';
  '@graph': JsonLdNode[];
};

const primaryNode: JsonLdNode =
  type === 'article'
    ? {
        '@type': 'Article',
        '@id': `${canonical}#article`,
        headline: title,
        description,
        url: canonical,
        image: imageObject,
        datePublished: publishedTime,
        dateModified: modifiedTime || publishedTime,
        keywords: tags,
        author: { '@id': personId },
        publisher: { '@id': personId },
        mainEntityOfPage: { '@id': canonical },
      }
    : {
        '@type': 'WebSite',
        '@id': websiteId,
        name: site.name,
        url: site.url,
        publisher: { '@id': personId },
      };

const graph: JsonLdNode[] = [primaryNode, person];

if (breadcrumbList) graph.push(breadcrumbList);

if (pageType === 'profile') {
  graph.push({
    '@type': 'ProfilePage',
    '@id': `${canonical}#profilepage`,
    url: canonical,
    name: fullTitle,
    description,
    mainEntity: { '@id': personId },
  });
} else if (pageType === 'collection') {
  graph.push({
    '@type': 'CollectionPage',
    '@id': `${canonical}#collectionpage`,
    url: canonical,
    name: fullTitle,
    description,
    isPartOf: { '@id': websiteId },
    about: { '@id': personId },
  });
} else if (pageType === 'itemList') {
  graph.push({
    '@type': 'ItemList',
    '@id': `${canonical}#itemlist`,
    url: canonical,
    name: title,
    numberOfItems: itemListItems.length,
    itemListElement: itemListItems.map((item, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: item.name,
      url: new URL(item.url, site.url).href,
    })),
  });
}

const jsonLd: JsonLd = {
  '@context': 'https://schema.org',
  '@graph': graph,
};
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<link rel="canonical" href={canonical} />
<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content="en_US" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
{
  ogDimensions && (
    <>
      <meta property="og:image:width" content={String(ogDimensions.width)} />
      <meta property="og:image:height" content={String(ogDimensions.height)} />
    </>
  )
}
<meta name="twitter:card" content="summary_large_image" />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{tags.map((tag) => <meta property="article:tag" content={tag} />)}
<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
