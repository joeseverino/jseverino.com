---
type NavItem = {
  href: string;
  label: string;
  current: boolean;
};

type Props = {
  items: NavItem[];
  listClass: string;
  linkClass: string;
};

const { items, listClass, linkClass } = Astro.props;
---

<ul class={listClass}>
  {items.map((item) => (
    <li>
      <a class={linkClass} href={item.href} aria-current={item.current ? 'page' : undefined}>{item.label}</a>
    </li>
  ))}
</ul>
