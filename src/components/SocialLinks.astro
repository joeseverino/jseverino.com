---
import { site } from '@lib/site.ts';
---

<ul class="social-links">
  {site.socialLinks.map((link) => (
    <li>
      <a href={link.href} aria-label={link.label} rel="me">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <use href={`#icon-${link.icon}`}></use>
        </svg>
      </a>
    </li>
  ))}
</ul>
