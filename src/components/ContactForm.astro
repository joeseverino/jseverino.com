---
import contactContract from '../../contracts/contact.v1.json' with { type: 'json' };
import { site } from '@lib/site.ts';
import { TURNSTILE_SCRIPT_URL } from '@lib/api/turnstile.ts';

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
const fields = contactContract.request.properties;
const linkedin = site.socialLinks.find((link) => link.icon === 'linkedin');
if (!linkedin) throw new Error('ContactForm needs a LinkedIn entry in site.socialLinks for its fallback link.');

// The form posts JSON with a Turnstile token, so it cannot work without JavaScript: it ships
// hidden, the script reveals it, and until then the LinkedIn line stands in. forms.css holds that
// line back for three seconds when scripting is on, so a page whose module loads in time never
// flashes it.
// "company" is a honeypot. inert keeps it from people (no focus, nothing read aloud), a bot that
// fills every input still fills it, and the API drops any submission that does.
---

<div class="contact-intake">
  <p class="contact-fallback prose">If the form is unavailable, <a href={linkedin.href}>get in touch on LinkedIn</a>.</p>
  <form class="contact-intake-form" action="/api/contact" method="post" data-timeout-ms={contactContract.runtime.submitTimeoutMs} hidden>
    <div class="contact-field">
      <label for="contact-name">Name</label>
      <input id="contact-name" name="name" autocomplete="name" required maxlength={fields.name.maxLength} />
    </div>
    <div class="contact-field">
      <label for="contact-email">Email</label>
      <input type="email" id="contact-email" name="email" autocomplete="email" required maxlength={fields.email.maxLength} />
    </div>
    <div class="contact-field">
      <label for="contact-message">Message</label>
      <textarea id="contact-message" name="message" required maxlength={fields.message.maxLength} rows="7"></textarea>
    </div>
    <div class="contact-field hidden-field" inert>
      <label for="contact-company">Company</label>
      <input id="contact-company" name="company" autocomplete="off" />
    </div>
    <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-action={contactContract.runtime.turnstileAction}></div>
    <p class="contact-privacy prose">
      Messages are stored in a private database. See <a href="/privacy/">Privacy</a> for details and data requests.
    </p>
    <button type="submit" class="button contact-submit">Send Message</button>
    <output class="contact-status"></output>
  </form>
</div>

<script is:inline async src={TURNSTILE_SCRIPT_URL}></script>

<script>
  declare global {
    interface Window {
      // The Turnstile script's global, once it has loaded.
      turnstile?: { reset(): void };
    }
  }

  const form = document.querySelector<HTMLFormElement>('.contact-intake-form');

  if (form) {
    const status = form.querySelector<HTMLOutputElement>('.contact-status');
    const button = form.querySelector<HTMLButtonElement>('.contact-submit');

    const show = (message: string, kind: 'success' | 'error') => {
      if (!status) return;
      status.textContent = message;
      status.dataset.kind = kind;
    };

    // An error stands only until the visitor changes the form.
    form.addEventListener('input', () => {
      if (status?.dataset.kind === 'error') {
        status.textContent = '';
        delete status.dataset.kind;
      }
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!button || button.disabled) return;

      const data = new FormData(form);
      // Turnstile writes its token into the form; without one the API refuses the submission.
      const token = String(data.get('cf-turnstile-response') ?? '');
      if (!token) {
        show('Please complete the verification challenge, then try again.', 'error');
        return;
      }

      button.disabled = true;
      form.setAttribute('aria-busy', 'true');
      button.textContent = 'Sending…';

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          signal: AbortSignal.timeout(Number(form.dataset.timeoutMs)),
          // The contract names the token turnstileToken, so the widget's own field stays out.
          body: JSON.stringify({
            ...Object.fromEntries(
              [...data.entries()].filter(([name]) => name !== 'cf-turnstile-response'),
            ),
            sourceUrl: window.location.href,
            turnstileToken: token,
          }),
        });
        const result = (await response.json().catch(() => ({}))) as {
          ok?: boolean;
          error?: string;
        };

        if (response.ok && result.ok) {
          form.reset();
          show("Thanks, your message has been sent. I'll get back to you soon.", 'success');
        } else {
          show(result.error ?? 'Something went wrong. Please try again.', 'error');
        }
      } catch (error) {
        show(error instanceof DOMException && error.name === 'TimeoutError'
          ? 'The request timed out. Please try again.'
          : 'Could not reach the server. Please try again in a moment.', 'error');
      } finally {
        button.disabled = false;
        form.removeAttribute('aria-busy');
        button.textContent = 'Send Message';
        // A token verifies once, so a retry needs a fresh one.
        window.turnstile?.reset();
      }
    });
    // Only a module that ran gets here, so the form can now stand in for the fallback.
    form.hidden = false;
    const fallback = document.querySelector<HTMLElement>('.contact-fallback');
    if (fallback) fallback.hidden = true;
  }
</script>
