---
// Shared by the portfolio page and `site render`, so a preview carries the shipped markup. Hero and body are slots.
import { formatDate, titleCase } from '@lib/content.ts';
import { tagPath } from '@lib/site-config.ts';

type Props = {
  title: string;
  date: string;
  technologies: string[];
};

const { title, date, technologies } = Astro.props;
---

<main id="main" class="article">
  <header class="article-header">
    <div class="article-meta">
      <h1 class="article-title">{title}</h1>
      {date && <p class="article-date"><time datetime={date}>{formatDate(date)}</time></p>}
    </div>
    {Astro.slots.has('hero') && <figure class="article-hero"><slot name="hero" /></figure>}
  </header>

  <article class="prose"><slot /></article>

  {
    technologies.length > 0 && (
      <footer class="article-tags">
        <h3>Technologies Used</h3>
        <div class="tech-pills">
          {technologies.map((tag) => (
            <a href={tagPath(tag)} rel="tag">{titleCase(tag)}</a>
          ))}
        </div>
        <hr class="article-separator" />
      </footer>
    )
  }
</main>
