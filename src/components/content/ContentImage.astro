---
import type { ImageMetadata } from 'astro';
import Image from '@components/Image.astro';

type Props = {
  src: ImageMetadata | string;
  alt?: string;
  width?: number | string;
  'data-no-zoom'?: string;
};

const { src, alt, width, 'data-no-zoom': noZoom } = Astro.props;
---

<Image src={src} alt={alt} width={width === undefined ? undefined : Number(width)} noZoom={noZoom !== undefined} />
