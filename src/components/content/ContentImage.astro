---
// Every Markdown image in content renders here (MDX maps <img> to it).
import type { ImageMetadata } from 'astro';
import Picture from '@components/Picture.astro';

type Props = {
  src: ImageMetadata | string;
  alt?: string;
  width?: number | string;
  'data-no-zoom'?: string;
};

const { src, alt, width, 'data-no-zoom': noZoom } = Astro.props;
---

<Picture src={src} alt={alt} width={width === undefined ? undefined : Number(width)} noZoom={noZoom !== undefined} />
