---
import { tagPath } from '@lib/site-config.ts';
import type { TagGroup } from '@components/tag-groups.ts';

type Props = { groups: TagGroup[] };

const { groups } = Astro.props;
---

<div class="archive-taxonomy">
  {
    groups.map((group) => {
      const headingId = `taxonomy-${group.name.replace(/\W+/g, '-').toLowerCase()}`;
      return (
        <section class="archive-taxonomy-group" aria-labelledby={headingId}>
          <h2 id={headingId} class="archive-taxonomy-title">
            {group.name}
          </h2>
          <div class="archive-taxonomy-list">
            {group.tags.map((tag) => (
              <a class="archive-tag" href={tagPath(tag.slug)} aria-label={`${tag.label}, ${tag.count} ${tag.count === 1 ? 'project' : 'projects'}`}>
                <span>{tag.label}</span>
                <span class="archive-tag-count">{tag.count}</span>
              </a>
            ))}
          </div>
        </section>
      );
    })
  }
</div>
