---
import ContentBody from '@components/content/ContentBody.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import { getPage } from '@lib/content.ts';
import { site } from '@lib/site.ts';

const page = await getPage('resume');
---

<BaseLayout
  seo={{
    title: page.title,
    description: page.description,
    path: page.path,
    pageType: 'profile',
    breadcrumbs: [
      { name: 'Home', url: '/' },
      { name: page.title, url: page.path },
    ],
  }}
>
  <main id="main" class="content-page resume-page">
    <div class="content-flow">
      <PageHero title={page.title} />
      <div class="prose">
        <ContentBody entry={page.entry} />
        <div class="actions"><a class="button sticky-button" href={site.resumePdf}>Download Resume</a></div>
      </div>
    </div>
  </main>
</BaseLayout>
