---
import ContentPage from '@layouts/ContentPage.astro';
import { getPage } from '@lib/content.ts';
import { site } from '@lib/site.ts';

const page = await getPage('resume');
---

<ContentPage page={page} pageType="profile" mainClass="resume-page" lede={false}>
  <div class="actions"><a class="button sticky-button" href={site.resumePdf}>Download Resume</a></div>
</ContentPage>
