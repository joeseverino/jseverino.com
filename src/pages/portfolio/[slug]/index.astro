---
import BaseLayout from '@layouts/BaseLayout.astro';
import { writeupPath } from '@lib/site-config.ts';
import Picture from '@components/Picture.astro';
import Lightbox from '@components/Lightbox.astro';
import ArticleView from '@components/content/ArticleView.astro';
import ContentBody from '@components/content/ContentBody.astro';
import { getWriteups } from '@lib/content.ts';

export async function getStaticPaths() {
  return (await getWriteups()).map((writeup) => ({
    params: { slug: writeup.slug },
    props: { writeup },
  }));
}

const { writeup } = Astro.props;
---

<BaseLayout
  seo={{
    title: writeup.title,
    description: writeup.description,
    path: writeupPath(writeup.slug),
    image: writeup.heroImage,
    type: 'article',
    publishedTime: writeup.date,
    modifiedTime: writeup.lastReviewed,
    tags: writeup.technologies,
    breadcrumbs: [
      { name: 'Home', url: '/' },
      { name: 'Portfolio', url: '/portfolio/' },
      { name: writeup.title, url: writeupPath(writeup.slug) },
    ],
  }}
>
  <ArticleView title={writeup.title} date={writeup.date} technologies={writeup.technologies}>
    <Picture
      slot="hero"
      src={writeup.heroImage}
      alt={writeup.heroAlt}
      sizes="(max-width: 720px) 100vw, 672px"
      loading="eager"
      fetchpriority="high"
    />
    <ContentBody entry={writeup.entry} />
  </ArticleView>
  {writeup.hasImages && <Lightbox />}
</BaseLayout>
