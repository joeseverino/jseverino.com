---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import ProjectCard from '@components/ProjectCard.astro';
import SoftwareCard from '@components/SoftwareCard.astro';
import SoftwareListItem from '@components/SoftwareListItem.astro';
import TagIndex from '@components/TagIndex.astro';
import { groupedTags } from '@components/tag-groups.ts';
import { getPage, getWriteups } from '@lib/content.ts';
import { getFeaturedSoftware, getMoreSoftware, getSoftware } from '@lib/software.ts';
import '@styles/software.css';

const page = await getPage('portfolio');
const writeups = await getWriteups();
const software = await getSoftware();
const featuredSoftware = getFeaturedSoftware(software);
const moreSoftware = getMoreSoftware(software);
const tagGroups = await groupedTags();
const tagCount = tagGroups.reduce((total, group) => total + group.tags.length, 0);
---

<BaseLayout
  seo={{
    title: page.title,
    description: page.description,
    path: page.path,
    pageType: 'collection',
    breadcrumbs: [
      { name: 'Home', url: '/' },
      { name: page.title, url: page.path },
    ],
  }}
>
  <main id="main" class="wide section">
    <PageHero title={page.title} description={page.intro ?? page.description} />

    <div class="tabs-wrap" hidden>
      <div class="portfolio-tabs" data-portfolio-tabs>
        <button class="portfolio-tab" type="button" id="tab-writeups" aria-controls="panel-writeups" data-tab="writeups">Writeups</button>
        <button class="portfolio-tab" type="button" id="tab-software" aria-controls="panel-software" data-tab="software">Software</button>
      </div>
    </div>

    <hr class="page-divider" />

    <section id="panel-writeups" class="portfolio-panel" data-panel="writeups">
      <ul class="project-grid">
        {writeups.map((writeup, index) => <ProjectCard writeup={writeup} eager={index === 0} />)}
      </ul>
      <details class="archive-section">
        <summary>
          <span>Browse by technology</span>
          <span>{tagCount} tags</span>
        </summary>
        <TagIndex groups={tagGroups} />
      </details>
    </section>

    <section id="panel-software" class="portfolio-panel" data-panel="software">
      <ul class="project-grid">
        {featuredSoftware.map((entry) => <SoftwareCard entry={entry} />)}
      </ul>

      {moreSoftware.length > 0 && (
        <div class="software-more">
          <h2 class="software-more-title">More projects</h2>
          <ul class="software-list">
            {moreSoftware.map((entry) => <SoftwareListItem entry={entry} />)}
          </ul>
        </div>
      )}
    </section>
  </main>
</BaseLayout>

<script>
  function initPortfolioTabs(): void {
    const root = document.querySelector<HTMLElement>('[data-portfolio-tabs]');
    if (!root) return;

    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panelFor = (name: string) =>
      document.querySelector<HTMLElement>(`[data-panel="${name}"]`);

    root.setAttribute('role', 'tablist');
    root.setAttribute('aria-label', 'Portfolio sections');
    for (const tab of tabs) {
      tab.setAttribute('role', 'tab');
      const panel = panelFor(tab.dataset.tab ?? '');
      panel?.setAttribute('role', 'tabpanel');
      panel?.setAttribute('aria-labelledby', tab.id);
    }

    function activate(name: string, updateHash: boolean): void {
      tabs.forEach((tab) => {
        const on = tab.dataset.tab === name;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        const panel = panelFor(tab.dataset.tab ?? '');
        if (panel) panel.hidden = !on;
      });
      if (updateHash) {
        const url = new URL(window.location.href);
        url.hash = name === 'software' ? 'software' : '';
        history.replaceState(history.state, '', url);
      }
    }

    root.addEventListener('click', (event) => {
      const tab = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('[role="tab"]') : null;
      if (tab) activate(tab.dataset.tab ?? '', true);
    });

    root.addEventListener('keydown', (event) => {
      const tab = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('[role="tab"]') : null;
      if (!tab) return;
      const i = tabs.indexOf(tab);
      const destinations: Record<string, number> = {
        ArrowRight: (i + 1) % tabs.length,
        ArrowLeft: (i + tabs.length - 1) % tabs.length,
        Home: 0,
        End: tabs.length - 1,
      };
      const index = destinations[event.key];
      const next = index === undefined ? undefined : tabs[index];
      if (!next) return;
      event.preventDefault();
      next.focus();
      activate(next.dataset.tab ?? '', true);
    });

    const syncFromUrl = () => activate(window.location.hash === '#software' ? 'software' : 'writeups', false);
    window.addEventListener('hashchange', syncFromUrl);
    syncFromUrl();
    root.closest<HTMLElement>('.tabs-wrap')?.removeAttribute('hidden');
  }

  initPortfolioTabs();
</script>
