---
import BaseLayout from '@layouts/BaseLayout.astro';
import ContentBody from '@components/content/ContentBody.astro';
import { getPage } from '@lib/content.ts';

const page = await getPage('home');
---

<BaseLayout
  seo={{
    title: page.title,
    description: page.description,
    path: page.path,
    breadcrumbs: [{ name: 'Home', url: '/' }],
  }}
>
  <main id="main">
    <ContentBody entry={page.entry} runs="home" />
  </main>
</BaseLayout>
