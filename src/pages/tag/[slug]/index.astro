---
import BaseLayout from '@layouts/BaseLayout.astro';
import { tagPath, writeupPath } from '@lib/site-config.ts';
import PageHero from '@components/PageHero.astro';
import ProjectCard from '@components/ProjectCard.astro';
import { getAllTags, getWriteups, projectCount } from '@lib/content.ts';

export async function getStaticPaths() {
  return (await getAllTags()).map((tag) => ({
    params: { slug: tag.slug },
    props: { tag },
  }));
}

const { tag } = Astro.props;
const allWriteups = await getWriteups();
const writeups = allWriteups.filter((writeup) => writeup.technologies.includes(tag.slug));
const tagName = tag.label;
---

<BaseLayout
  seo={{
    title: `${tagName} Projects`,
    description: `Portfolio writeups tagged ${tagName}.`,
    path: tagPath(tag.slug),
    pageType: 'itemList',
    itemListItems: writeups.map((writeup) => ({
      name: writeup.title,
      url: writeupPath(writeup.slug),
    })),
    breadcrumbs: [
      { name: 'Home', url: '/' },
      { name: 'Portfolio', url: '/portfolio/' },
      { name: tagName, url: tagPath(tag.slug) },
    ],
  }}
>
  <main id="main" class="cards">
    <PageHero
      class="page-hero--tag"
      title={`${tagName} Projects`}
      description={`${projectCount(writeups.length)} tagged ${tagName}.`}
    >
      <nav class="tag-list page-actions" aria-label="Portfolio">
        <a class="pill pill--nav" href="/portfolio/">All projects</a>
      </nav>
    </PageHero>
    <hr class="page-divider" />
    <ul class="project-grid">
      {writeups.map((writeup, index) => <ProjectCard writeup={writeup} priority={index === 0} />)}
    </ul>
  </main>
</BaseLayout>
