---
import ContentPage from '@layouts/ContentPage.astro';
import { getEducationInstitutions } from '@lib/content.ts';

export async function getStaticPaths() {
  return (await getEducationInstitutions()).map((page) => ({
    params: { institution: page.slug.replace(/^education\//, '') },
    props: { page },
  }));
}

const { page } = Astro.props;
---

<ContentPage page={page} parents={[{ name: 'Education', url: '/education/' }]} mainClass="document-page" />
