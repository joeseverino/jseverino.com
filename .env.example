# Local development values. Copy to .env (gitignored): Astro reads the PUBLIC_
# keys at build time and `wrangler pages dev` reads the rest as Function
# secrets. Production sets both in the Cloudflare dashboard.

# Cloudflare Turnstile's "always passes" TEST keys. With the test secret,
# functions/api/contact.ts accepts siteverify's test hostname (localhost) and
# action (test); any other secret requires jseverino.com and the contact action.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
