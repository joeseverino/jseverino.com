# Local development values. Copy to .env (gitignored): Astro reads the PUBLIC_
# keys at build time, and the local Worker runtime (`astro dev`, `astro preview`)
# reads the rest as its secrets. Production sets both in Cloudflare.

# Cloudflare Turnstile's "always passes" TEST keys. With the test secret,
# src/lib/api/contact.ts accepts siteverify's test hostname (localhost) and
# action (test); any other secret requires jseverino.com and the contact action.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
