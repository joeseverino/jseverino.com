{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jseverino.com/.github/repo.schema.json",
  "title": "GitHub repository desired state",
  "description": "The repository settings, security features, Actions permissions, and branch ruleset bin/github.ts checks and applies. See docs/GitHub-Settings.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["repository", "settings", "topics", "security", "actions", "variables", "ruleset"],
  "properties": {
    "$schema": { "type": "string" },
    "repository": { "description": "owner/name.", "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "settings": {
      "description": "Repository fields (PATCH /repos/:repository). Squash is the only merge method: rebase merging strips SSH commit signatures, and the ruleset below refuses the rest.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_squash_merge",
        "allow_merge_commit",
        "allow_rebase_merge",
        "allow_auto_merge",
        "delete_branch_on_merge",
        "squash_merge_commit_title",
        "squash_merge_commit_message",
        "has_wiki",
        "description",
        "homepage"
      ],
      "properties": {
        "allow_squash_merge": { "type": "boolean" },
        "allow_merge_commit": { "type": "boolean" },
        "allow_rebase_merge": { "type": "boolean" },
        "allow_auto_merge": {
          "description": "Off: nothing here enables auto-merge, so every pull request, Renovate's included, is merged deliberately.",
          "type": "boolean"
        },
        "delete_branch_on_merge": { "type": "boolean" },
        "squash_merge_commit_title": { "enum": ["PR_TITLE", "COMMIT_OR_PR_TITLE"] },
        "squash_merge_commit_message": { "enum": ["PR_BODY", "COMMIT_MESSAGES", "BLANK"] },
        "has_wiki": { "type": "boolean" },
        "description": {
          "description": "The About text. It makes claims about the site, so it is checked like the docs are.",
          "type": "string",
          "minLength": 1
        },
        "homepage": { "type": "string", "pattern": "^https://" }
      }
    },
    "topics": {
      "description": "Repository topics; the order does not matter.",
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
    },
    "security": {
      "description": "Repository security features.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secret_scanning",
        "secret_scanning_push_protection",
        "dependabot_security_updates",
        "vulnerability_alerts",
        "private_vulnerability_reporting",
        "code_scanning"
      ],
      "properties": {
        "secret_scanning": { "$ref": "#/$defs/status" },
        "secret_scanning_push_protection": { "$ref": "#/$defs/status" },
        "dependabot_security_updates": { "description": "Off: Renovate opens the security fixes, from the alerts below.", "$ref": "#/$defs/status" },
        "vulnerability_alerts": {
          "description": "GitHub's vulnerability alerts, which Renovate reads to open a fix at once; an accepted advisory is an alert dismissed with a reason.",
          "type": "boolean"
        },
        "private_vulnerability_reporting": { "type": "boolean" },
        "code_scanning": {
          "description": "CodeQL default setup (PATCH /repos/:repository/code-scanning/default-setup). The ruleset's code_scanning rule requires its results, so both change in one apply.",
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "languages"],
          "properties": {
            "state": { "enum": ["configured", "not-configured"] },
            "languages": {
              "type": "array",
              "items": { "enum": ["actions", "c-cpp", "csharp", "go", "java-kotlin", "javascript-typescript", "python", "ruby", "swift"] }
            }
          }
        }
      }
    },
    "actions": {
      "description": "Actions permissions (PUT /repos/:repository/actions/permissions and .../workflow).",
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_actions", "sha_pinning_required", "default_workflow_permissions", "can_approve_pull_request_reviews"],
      "properties": {
        "allowed_actions": { "enum": ["all", "local_only", "selected"] },
        "sha_pinning_required": {
          "description": "Every `uses:` reference must be a full commit SHA, which zizmor (checks:workflows) also enforces.",
          "type": "boolean"
        },
        "default_workflow_permissions": { "enum": ["read", "write"] },
        "can_approve_pull_request_reviews": { "type": "boolean" }
      }
    },
    "variables": {
      "description": "Actions variables (not secrets), by name. The ci build job builds the site it deploys with the public Turnstile site key. Variables not listed here are left alone.",
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "ruleset": {
      "description": "The branch ruleset on the default branch, as the REST API returns it, without ids. Compared as a whole: rules and status checks in any order.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "target", "enforcement", "bypass_actors", "conditions", "rules"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "target": { "enum": ["branch"] },
        "enforcement": { "enum": ["active", "evaluate", "disabled"] },
        "bypass_actors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["actor_id", "actor_type", "bypass_mode"],
            "properties": {
              "actor_id": { "type": "integer" },
              "actor_type": { "type": "string" },
              "bypass_mode": { "enum": ["always", "pull_request"] }
            }
          }
        },
        "conditions": { "type": "object" },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
              "type": { "type": "string", "minLength": 1 },
              "parameters": { "type": "object" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "status": { "enum": ["enabled", "disabled"] }
  }
}
