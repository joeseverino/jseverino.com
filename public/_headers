# Cloudflare Pages headers.
# Pages MERGES the headers of every matching rule rather than letting the most
# specific one win. For a single-value header like Cache-Control that means
# overlapping path rules combine, so they must not contradict: the immutable rule
# is scoped to write-once dirs and must never be a broad /assets/*, or it re-adds
# immutable to the in-place chrome assets and pins a stale logo for a year.

# Fingerprinted Astro assets and synced static assets.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
  ! Access-Control-Allow-Origin
  Content-Security-Policy: default-src 'none'; img-src 'self'; style-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'

# Unversioned files (resume PDF, signed docs): short cache so an update
# propagates within an hour instead of riding the immutable rule below.
/assets/docs/*
  Cache-Control: public, max-age=3600, must-revalidate
  ! Access-Control-Allow-Origin

# Chrome assets that change in place (favicons, brand marks, OG cards). Stable
# filenames whose contents get replaced on a rebrand, so they get a short
# must-revalidate cache and are deliberately kept out of the immutable rule below.
/favicon.ico
  Cache-Control: public, max-age=3600, must-revalidate
  ! Access-Control-Allow-Origin
  Content-Security-Policy: default-src 'none'; img-src 'self'; style-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'

/assets/icons/*
  Cache-Control: public, max-age=3600, must-revalidate
  ! Access-Control-Allow-Origin

/assets/brand/*
  Cache-Control: public, max-age=3600, must-revalidate
  ! Access-Control-Allow-Origin

/assets/og/*
  Cache-Control: public, max-age=3600, must-revalidate
  ! Access-Control-Allow-Origin

# The webfont keeps the 1-year immutable cache (content images are under
# /_astro/, content-hashed). Scoped per-dir, not a broad /assets/*, so it never
# overlaps the chrome paths above: a stale logo pinned for a year is the failure
# mode that scoping prevents.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  ! Access-Control-Allow-Origin

# WKD key: explicit content-type since the binary key file has no
# extension, and a short cache so revocations propagate within minutes.
/.well-known/openpgpkey/*
  Content-Type: application/octet-stream
  Cache-Control: public, max-age=300, must-revalidate

/*.html
  Cache-Control: public, max-age=300, must-revalidate

# Keep branch and deployment preview URLs out of search indexes. The canonical
# custom domain still indexes normally.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# Static CSP for every path public/_routes.json excludes from Functions.
# Those responses skip the middleware, and a miss under an excluded prefix
# gets that prefix's own 404.html (bin/build-static.ts writes it: no script,
# no style). /_astro/* and /favicon.ico carry theirs in the cache rules above:
# a path listed twice keeps only its last block. tests/audits/check-routes.ts
# keeps the excludes covered and every path listed once.
/assets/*
  Content-Security-Policy: default-src 'none'; img-src 'self'; style-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'

/embed/*
  Content-Security-Policy: default-src 'none'; img-src 'self'; style-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'

/schemas/*
  Content-Security-Policy: default-src 'none'; img-src 'self'; style-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'

/.well-known/*
  Content-Security-Policy: default-src 'none'; img-src 'self'; style-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'

/robots.txt
  Content-Security-Policy: default-src 'none'; img-src 'self'; style-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'

/sitemap-index.xml
  Content-Security-Policy: default-src 'none'; img-src 'self'; style-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'

/sitemap-0.xml
  Content-Security-Policy: default-src 'none'; img-src 'self'; style-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'

/feed.xml
  Content-Security-Policy: default-src 'none'; img-src 'self'; style-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'

/content-index.json
  Content-Security-Policy: default-src 'none'; img-src 'self'; style-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'

# Security headers for every route.
# Content-Security-Policy for HTML routes is issued per request (with a nonce)
# by functions/_middleware.ts; public/_routes.json keeps every HTML route on
# Functions (tests/audits/check-routes.ts).
# Strict-Transport-Security is set at the Cloudflare zone level (SSL/TLS →
# Edge Certificates → HSTS) so it applies to every response without being
# duplicated here.
/*
  ! Access-Control-Allow-Origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  X-Permitted-Cross-Domain-Policies: none
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-site
  Permissions-Policy: accelerometer=(), autoplay=(), browsing-topics=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), hid=(), idle-detection=(), interest-cohort=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), sync-xhr=(), unload=(), usb=(), xr-spatial-tracking=()
