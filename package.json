  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.4",
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.0",
    "js-yaml": "^5.5.0",
    "satteri": "^0.10.5",
    "sitedrift": "^0.5.0"
  },
  "optionalDependencies": {
    "branding-engine": "^0.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "fast-check": "^4.10.2",
    "lighthouse": "^13.5.0",
    "severino-brand": "https://github.com/joeseverino/severino-brand/releases/download/v2.0.0/severino-brand-2.0.0.tgz",
    "sharp": "^0.35.4",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.151.0"
  },
  "allowScripts": {
    "esbuild": false,
    "workerd": false,
    "fsevents": false
  }
