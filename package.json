{
  "name": "jseverino-com",
  "version": "6.0.0",
  "description": "Personal site for Joe Severino, built with Astro, sourced from a private notes vault, served on Cloudflare Pages.",
  "private": true,
  "license": "UNLICENSED",
  "author": "Joe Severino",
  "homepage": "https://jseverino.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joeseverino/jseverino.com.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.19.0",
  "bin": {
    "site": "bin/site.ts"
  },
  "scripts": {
    "help": "node bin/help.ts",
    "site": "node bin/site.ts",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "dev:drafts": "node bin/site.ts dev --drafts",
    "sync:content": "node bin/sync-content.ts",
    "sync:contract": "node bin/sync-content-contract.ts",
    "sync:contact-openapi": "node bin/sync-contact-openapi.ts",
    "sync:tokens": "node bin/sync-tokens.ts",
    "sync:edge-site": "node bin/sync-edge-site.ts",
    "sync:docs": "node bin/sync-docs.ts",
    "snapshot:github": "node bin/snapshot-github.ts",
    "diagnose": "node bin/diagnose.ts",
    "diff:build": "node bin/diff-build.ts",
    "gate:check": "node bin/gate-check.ts",
    "publish:check": "node bin/publish-check.ts",
    "publish:check:ci": "node bin/ci-rehearsal.ts",
    "release:check": "node bin/release-check.ts",
    "deploy:verify": "node bin/deploy-verify.ts",
    "cloudflare:check": "node bin/cloudflare.ts check",
    "cloudflare:plan": "node bin/cloudflare.ts plan",
    "cloudflare:apply": "node bin/cloudflare.ts apply",
    "d1:apply": "wrangler d1 execute jseverino-contact --remote --file=cloudflare/d1.sql",
    "build": "npm run -s check && npm run -s build:static",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "edge:serve": "node bin/edge-serve.ts",
    "make:icons": "node bin/make-icons.ts",
    "make:og": "node bin/make-og-image.ts",
    "make:embed": "node bin/make-embed-bundle.ts",
    "make:social": "node bin/make-github-social.ts",
    "make:font": "node bin/make-font.ts",
    "make:content-index": "node bin/make-content-index.ts",
    "scaffold:primer": "node bin/scaffold-primer.ts",
    "scaffold:writeup-field": "node bin/scaffold-writeup-field.ts",
    "draft:cover-alt": "node bin/draft-cover-alt.ts",
    "sign:security": "node bin/sign-security.ts",
    "seo:preview": "node bin/seo-preview.ts",
    "test:unit": "node --test 'tests/unit/**/*.test.ts'",
    "test:e2e": "playwright test -c tests/playwright.config.ts",
    "test:e2e:ui": "playwright test -c tests/playwright.config.ts --ui",
    "test:e2e:visual": "playwright test -c tests/playwright.visual.config.ts",
    "test:e2e:visual:update": "playwright test -c tests/playwright.visual.config.ts --update-snapshots",
    "test:edge": "playwright test -c tests/playwright.edge.config.ts",
    "clean:generated": "node bin/clean-generated.ts",
    "check": "npm run -s lint:css && npm run -s check:css-vars && NODE_OPTIONS=--max-old-space-size=4096 ASTRO_TELEMETRY_DISABLED=1 astro check --minimumSeverity warning --tsconfig tsconfig.astro.json",
    "build:static": "node bin/build-static.ts",
    "lint:css": "stylelint \"src/styles/**/*.css\"",
    "check:css-vars": "node tests/audits/check-css.ts",
    "check:security": "node tests/audits/check-security-txt.ts",
    "check:contrast": "node tests/audits/check-contrast.ts",
    "check:parity": "node tests/audits/check-vault-mcp-parity.ts",
    "check:preview": "node tests/audits/check-sitedrift-preview.ts",
    "check:docs": "node tests/audits/check-docs.ts",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 astro sync && tsc -p . && tsc -p functions",
    "check:edge": "node tests/audits/check-functions-parity.ts",
    "check:html": "node tests/audits/check-html.ts",
    "check:links": "node tests/audits/check-links.ts",
    "check:weight": "node tests/audits/check-page-weight.ts",
    "check:seo": "node tests/audits/check-seo.ts",
    "check:routes": "node tests/audits/check-routes.ts",
    "check:repo-policy": "node tests/audits/check-repository-policy.ts",
    "check:lighthouse": "node bin/lighthouse-check.ts",
    "audit:assets": "node tests/audits/audit-assets.ts",
    "audit": "node bin/audit.ts",
    "content:diff": "node bin/content-diff.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5",
    "js-yaml": "^4.3.2",
    "markdown-it": "^15.0.2",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "sharp": "$sharp"
  },
  "optionalDependencies": {
    "branding-engine": "^0.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.19.1",
    "lighthouse": "^13.5.0",
    "severino-brand": "https://github.com/joeseverino/severino-brand/releases/download/v1.0.2/severino-brand-1.0.2.tgz",
    "sharp": "^0.35.4",
    "sitedrift": "^0.3.11",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "wrangler": "^4.145.0"
  },
  "allowScripts": {
    "esbuild": false,
    "workerd": false,
    "fsevents": false
  }
}
