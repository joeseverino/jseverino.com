# Static-asset headers: https://developers.cloudflare.com/workers/static-assets/headers/
# They apply to the assets only; the Worker's own responses (the API routes and
# the preview proxy) set theirs in code.
# Cloudflare MERGES the headers of every matching rule rather than letting the most
# specific one win. For a single-value header like Cache-Control that means
# overlapping path rules combine, so they must not contradict: the immutable rule
# is scoped to write-once dirs and must never be a broad /assets/*, or it re-adds
# immutable to the in-place chrome assets and pins a stale logo for a year.

# Fingerprinted Astro assets and synced static assets.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Unversioned files (resume PDF, signed docs): short cache so an update
# propagates within an hour instead of riding the immutable rule below.
/assets/docs/*
  Cache-Control: public, max-age=3600, must-revalidate

# Chrome assets that change in place (favicons, brand marks, OG cards). Stable
# filenames whose contents get replaced on a rebrand, so they get a short
# must-revalidate cache and are deliberately kept out of the immutable rule below.
/favicon.ico
  Cache-Control: public, max-age=3600, must-revalidate

/assets/icons/*
  Cache-Control: public, max-age=3600, must-revalidate

/assets/brand/*
  Cache-Control: public, max-age=3600, must-revalidate

/assets/og/*
  Cache-Control: public, max-age=3600, must-revalidate

# The webfont keeps the 1-year immutable cache (content images are under
# /_astro/, content-hashed). Scoped per-dir, not a broad /assets/*, so it never
# overlaps the chrome paths above: a stale logo pinned for a year is the failure
# mode that scoping prevents.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# WKD key: explicit content-type since the binary key file has no
# extension, and a short cache so revocations propagate within minutes.
/.well-known/openpgpkey/*
  Content-Type: application/octet-stream
  Cache-Control: public, max-age=300, must-revalidate

# Keep the Worker's preview URLs (<alias or version>-<worker>.<account>.workers.dev)
# out of search indexes; a host placeholder matches one label. The canonical
# custom domain still indexes normally.
https://:label.:subdomain.workers.dev/*
  X-Robots-Tag: noindex

# Security headers for every route.
# The Content-Security-Policy hashes the one inline script and the inlined
# stylesheet each page carries, so bin/build-csp.ts fills the placeholders below
# when it builds the served _headers. Cloudflare MERGES the rules that match a path, so the
# contact page detaches the global policy and sets its own: Turnstile's script
# writes to Trusted Types sinks without a policy, so there that directive is
# reported rather than enforced.
# Strict-Transport-Security is set at the Cloudflare zone level (SSL/TLS →
# Edge Certificates → HSTS) so it applies to every response without being
# duplicated here.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'sha256-Gqg0UvySFfdY9j/sxHJ4YY72pxRlU4G3OOTi5pFeT1w=' https://challenges.cloudflare.com https://static.cloudflareinsights.com; require-trusted-types-for 'script'; style-src 'self' 'sha256-P8kws9K74/ey0peeQK+p74sRKljbLL8CNBEgL6jstNc=' 'sha256-k6JGmoPiJv7/mRi1tycfsMCTb4/gjMbY+7/tAfWwIeY=' 'sha256-V4wRq7jeRuKt6Vlfi7NtZ4RjLmIxdvcdVIhkq9ZTLoE=' 'sha256-nFBwjoVyI5C2QVCqK0dwJKJ4OQhE5t+On2K++jxJh9g='; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com https://challenges.cloudflare.com; frame-src 'self' https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests; report-to csp-endpoint; report-uri https://jseverino.com/api/csp-report
  Reporting-Endpoints: csp-endpoint="https://jseverino.com/api/csp-report"
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  X-Permitted-Cross-Domain-Policies: none
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-site
  Permissions-Policy: accelerometer=(), autoplay=(), browsing-topics=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), hid=(), idle-detection=(), interest-cohort=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), sync-xhr=(), unload=(), usb=(), xr-spatial-tracking=()

