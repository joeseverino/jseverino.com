# Dependencies
node_modules

# Astro and Wrangler generated state
.astro/
.wrangler/

# Build output
/dist/
/dist-visual/

# The drafts preview overlay (bin/lib/cache.ts); caches live under SITE_CACHE_DIR
/.cache/

# Playwright artifacts
/playwright-report/
/test-results/
.playwright-mcp/

# Environment and local machine files
.env
.env.*
.dev.vars
.dev.vars.*
mise.local.toml
.DS_Store
.claude/

# Stray root-level binaries (export PDFs, screenshots, etc.).
# Intentional PDFs live under public/assets/docs/.
/*.pdf
/*.png

# Logs
*.log

# Generated at build from src/content/writeups (see bin/make-content-index.ts)
public/content-index.json

# Lighthouse output from bin/lighthouse-check.ts
lighthouse-reports/
CLAUDE.local.md
