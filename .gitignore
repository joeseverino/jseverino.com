# Dependencies
node_modules

# branding-engine glyph cache (only written when extracting a custom font)
.brand-cache/

# Astro, Vite, and Wrangler generated state
.astro/
.vite/
.wrangler/

# Build output
/dist/
/dist-visual/

# Image-encode cache and the drafts preview overlay (bin/lib/cache.ts)
/.cache/

# Playwright artifacts
/playwright-report/
/test-results/
.playwright-mcp/
.validation-report.md

# Environment and local machine files
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
.DS_Store
.claude/
.gemini/
.obsidian/
AGENTS.md

# Stray root-level binaries (export PDFs, screenshots, etc.).
# Intentional PDFs live under public/assets/docs/.
/*.pdf
/*.png

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Generated at build from src/content/writeups (see bin/make-content-index.ts)
public/content-index.json

# Lighthouse output from bin/lighthouse-check.ts
lighthouse-reports/
